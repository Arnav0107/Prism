# Monad Testnet Configuration
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# Deployer Configuration
PRIVATE_KEY=0x<YOUR_KEY>

# Protocol Ownership (Optional: defaults to deployer if unset)
OWNER=

# Demo Mode: Deploy.s.sol defaults DEMO_MODE to true only on chain 31337 and false on Monad.
# Set DEMO_MODE=true explicitly for live demos so fundEpoch can be called before the ex-date (90 days).
# Note: setDemoMode on PrismVault can only disable demo mode, never re-enable it.
DEMO_MODE=true

# Monad Explorer API Key (Optional)
MONADVISION_API_KEY=

