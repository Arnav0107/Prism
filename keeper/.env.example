# Prism Autonomous Keeper Configuration
# Node.js Keeper daemon for epoch funding, dividend claim fulfillment, and expired auction housekeeping

# Network RPC endpoint and Chain ID
RPC_URL=http://127.0.0.1:8545
# Optional: 31337 for local Anvil, 10143 for Monad Testnet (auto-detected via getChainId if omitted)
CHAIN_ID=31337

# Keeper signer private key (MUST NOT use mainnet keys with real assets)
# Note: For local Anvil testing only, 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 may be used.
# For Monad Testnet, provide your funded testnet keeper private key:
PRIVATE_KEY=0xYOUR_KEEPER_PRIVATE_KEY_HERE

# Prism Core Contract Addresses (leave blank to auto-load from web/src/chain/deployments.local.json or deployments/monad-testnet.json)
PRISM_VAULT_ADDRESS=
PRISM_AUCTION_ADDRESS=
EPOCH_COUPON_ADDRESS=
MOCK_USDC_ADDRESS=

# Keeper Operational Tuning
POLL_INTERVAL_MS=5000
# Review MAX_FEE_PER_GAS_GWEI against Monad network gas pricing (typically 50-100 gwei on testnet)
MAX_FEE_PER_GAS_GWEI=50
MAX_RETRIES=3
DRY_RUN=false

