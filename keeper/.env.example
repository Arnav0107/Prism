# Prism Autonomous Keeper Configuration
# Node.js Keeper daemon for epoch funding, dividend claim fulfillment, and expired auction housekeeping

# Network RPC endpoint
RPC_URL=http://127.0.0.1:8545

# Keeper signer private key (MUST NOT use mainnet keys with real assets)
# Default Anvil account 0 private key for local development:
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Prism Core Contract Addresses (leave blank to auto-load from web/src/chain/deployments.local.json)
PRISM_VAULT_ADDRESS=
PRISM_AUCTION_ADDRESS=
EPOCH_COUPON_ADDRESS=
MOCK_USDC_ADDRESS=

# Keeper Operational Tuning
POLL_INTERVAL_MS=5000
MAX_FEE_PER_GAS_GWEI=50
MAX_RETRIES=3
DRY_RUN=false
